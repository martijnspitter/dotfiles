[
  {
    "label": "Run Vitest",
    "command": "NODE_ENV=test nx vite:test klar-fe",
    "args": [
      "\"$ZED_FILENAME\" -t \"$ZED_SYMBOL\""
    ],
    "tags": [
      "tsx-test",
      "ts-test",
      "js-test",
      "jest-test"
    ]
  },
  {
    "label": "file_finder",
    "command": "zed \"$(tv files)\"",
    "hide": "always",
    "allow_concurrent_runs": true,
    "use_new_terminal": true
  },
  {
    "label": "LazyGit",
    "command": "lazygit",
    "shell": {
      "program": "sh"
    },
    "hide": "on_success",
    "reveal_target": "center",
    "show_summary": false,
    "show_command": false,
    "allow_concurrent_runs": true,
    "use_new_terminal": true
  }
]
